# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# SQLite (default). For Postgres use:
# DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
DATABASE_URL=sqlite:///db.sqlite3

# Optional: Redis enables cross-process WebSockets and Celery.
# Leave blank in development to use in-memory channels and eager tasks.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible)
# provider: mock | openai
# Works with OpenAI, Azure OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio.
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Optional: use a different host/deployment for embeddings (defaults to LLM_BASE_URL)
LLM_EMBEDDING_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
# Comma separated list shown in the UI (defaults to LLM_CHAT_MODEL)
LLM_MODEL_CHOICES=gpt-4o-mini,gpt-4o
# JSON object of extra headers sent to the provider
LLM_EXTRA_HEADERS={}
# JSON object of query parameters appended to every provider request
# (Azure OpenAI needs {"api-version": "2024-02-01"})
LLM_EXTRA_QUERY={}

# Local Ollama example:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_CHAT_MODEL=llama3.1
# LLM_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_EMBED_BATCH_SIZE=32
RAG_MAX_CANDIDATES=2000
RAG_MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
DEFAULT_MONTHLY_TOKEN_QUOTA=200000
CHAT_HISTORY_LIMIT=24

# ---------------------------------------------------------------------------
# Email (console backend in development)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=chatbot@example.com

# ---------------------------------------------------------------------------
# Production only
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
